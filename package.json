{
  "name": "pi-customizations",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Pi extensions and skills, with optional NixOS integrations",
  "license": "GPL-3.0-only",
  "keywords": ["pi-package"],
  "repository": "github:pineapplehunter/pi-customizations",
  "engines": { "node": ">=22.18.0" },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "markdown-it": "14.3.3",
    "ws": "8.23.0"
  },
  "pi": {
    "extensions": ["extensions/*.ts", "extensions/*/index.ts"],
    "skills": ["skills", "extensions/pueue-tool/skills"]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs extensions/pueue-tool/tests/*.test.mjs"
  }
}
